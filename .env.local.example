# Free key from https://api.census.gov/data/key_signup.html — required to run
# `npm run fetch:census` (scripts/fetchCensusData.ts) for the /us section.
# Never needed at app runtime, only for this one-shot data-generation script.
CENSUS_API_KEY=

# The site's real production domain, e.g. https://example.com (protocol and
# trailing slash are optional — lib/site-url.ts normalizes both). Drives two
# things, with different fallback behavior for each:
#   - canonical/og:url/og:image/twitter:image (lib/site-url.ts, lib/seo.ts):
#     if this is unset, falls back to Netlify's auto-injected URL (prod
#     deploys) or DEPLOY_PRIME_URL (preview deploys), then localhost:3000 as
#     a last resort — see lib/site-url.ts for the exact priority order.
#   - manually placed ad units (lib/ads.ts, components/ads/AdSlot.tsx):
#     only render when this is set to the production host. The site-wide
#     Auto ads loader does not depend on this variable.
NEXT_PUBLIC_SITE_URL=

# AdSense publisher ID for manually placed ad units — this site's is
# ca-pub-7379794980536826 (matches public/ads.txt and the Auto ads loader).
# Leave empty to disable manual ad units; the site-wide Auto ads loader uses
# its own public constant and is unaffected.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Ad slot IDs are NOT read from env vars inside components/ads/AdSlot.tsx —
# it takes `slot` as a prop so one component can serve many placements.
# Define one env var per placement wherever you use <AdSlot />, e.g.:
#   NEXT_PUBLIC_ADSENSE_SLOT_INSIGHTS=
#   <AdSlot slot={process.env.NEXT_PUBLIC_ADSENSE_SLOT_INSIGHTS!} />
#
# Current placements (all empty = no ad unit created yet; AdSlot renders
# nothing until both this and NEXT_PUBLIC_ADSENSE_CLIENT_ID above are set):
#   - app/us/insights/[slug]/page.tsx  — mid-article break in the post body
NEXT_PUBLIC_ADSENSE_SLOT_INSIGHTS_MID=
#   - app/us/insights/[slug]/page.tsx  — below the post, after the CTA box
#   - app/us/insights/page.tsx         — bottom of the article list
NEXT_PUBLIC_ADSENSE_SLOT_INSIGHTS_BOTTOM=
#   - app/us/page.tsx (UsHomeClient.tsx) — bottom of the state-picker map page
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
#   - app/us/[state]/page.tsx          — above the "counties in {state}" directory
#   - app/us/[state]/[county]/page.tsx — below the income thresholds table
NEXT_PUBLIC_ADSENSE_SLOT_GEO=
#   - app/us/result/page.tsx and app/us/[state]/[county]/[place]/page.tsx —
#     both render the same "full" PersonalizedResult dashboard, so they
#     share this one slot. Below the result dashboard (and, on the place
#     page, below the "See full breakdown" toggle) — kept well clear of the
#     share/compare buttons — an ad placed right next to those risks
#     accidental taps on it, which is an AdSense policy violation (invalid
#     click activity), not just bad UX.
NEXT_PUBLIC_ADSENSE_SLOT_RESULT=
